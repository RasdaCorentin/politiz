# Modèle du fichier d'environnement de la variante distribuée (infra/distribue/AGENTS.md).
# Copier en infra/distribue/.env sur le poste de commande, puis le déployer avec deployer.sh.
# Adresses : plages de documentation (RFC 5737), à remplacer par les adresses réelles.
# Mots de passe : valeurs de DÉVELOPPEMENT, à remplacer. Ne jamais les réutiliser ailleurs.

# Adresses des trois machines (fixes ou baux DHCP réservés)
IP_VM1=192.0.2.10
IP_VM2=192.0.2.20
IP_C=192.0.2.30

# MinIO : même valeur sur les trois nœuds
MINIO_ROOT_USER=sae-root
MINIO_ROOT_PASSWORD=dev-root-change-me-0001
S3_ACCESS_KEY=sae-pipeline
# Clé secrète S3 : 40 caractères au plus (limite du compte de service MinIO).
# Générer une valeur réelle : openssl rand -hex 16 (32 caractères).
S3_SECRET_KEY=dev-pipeline-change-me-0002

# ClickHouse : comptes pipeline (INSERT, SELECT) et dashboard (SELECT)
CLICKHOUSE_PIPELINE_PASSWORD=dev-pipeline-ch-0003
CLICKHOUSE_DASHBOARD_PASSWORD=dev-dashboard-ch-0004

# Secret d'authentification Spark (spark.authenticate) : même valeur sur les trois machines
SPARK_SECRET=dev-spark-change-me-0005

# Cluster Spark : 2 workers, WORKER_CORES cœurs et WORKER_MEMORY de mémoire chacun
WORKER_CORES=2
WORKER_MEMORY=1536m
WORKER_MEM_LIMIT=4096m
EXECUTOR_MEMORY=1g
DRIVER_MEMORY=768m

# Producteur
PRODUCER_SOURCE=synthetic
PRODUCER_RATE=5
LEAK_MARKER=temoin-fuite-0001

# Dashboard : bandeau affiché en haut de la page. Vide sur le flux réel ; « Données synthétiques »
# seulement avec PRODUCER_SOURCE=synthetic.
DASHBOARD_BANDEAU=

# Modèles CamemBERT : dossier présent sur VM1 et VM2 (vide : règles lexique seules)
MODELES_DIR=/opt/sae-modeles
# Runs du modèle : infra/distribue/modeles.env (versionné), téléchargés depuis MinIO par infra/deploiement/tirer.py.
