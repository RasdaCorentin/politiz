# Copier en infra/.env (non versionné). Valeurs de DÉVELOPPEMENT : ne jamais les réutiliser ailleurs.

# MinIO : compte d'administration et compte de service limité aux buckets scores et checkpoints
MINIO_ROOT_USER=sae-root
MINIO_ROOT_PASSWORD=dev-root-change-me-0001
S3_ACCESS_KEY=sae-pipeline
S3_SECRET_KEY=dev-pipeline-change-me-0002

# ClickHouse : utilisateurs pipeline (INSERT, SELECT) et dashboard (SELECT)
CLICKHOUSE_PIPELINE_PASSWORD=dev-pipeline-ch-0003
CLICKHOUSE_DASHBOARD_PASSWORD=dev-dashboard-ch-0004

# Cluster Spark : 2 workers, WORKER_CORES cœurs et WORKER_MEMORY de mémoire chacun
WORKER_CORES=2
WORKER_MEMORY=1536m
EXECUTOR_MEMORY=1g
DRIVER_MEMORY=768m

# Producteur (profil pipeline)
PRODUCER_SOURCE=synthetic
PRODUCER_RATE=5
LEAK_MARKER=temoin-fuite-0001

# Dashboard (profil pipeline) : dashboard-api lit ClickHouse ; valeurs par défaut listées dans le contrat (docs/technique/contrats-poc.md)
# DASHBOARD_SEUIL_DEFAUT=20
# FRAICHEUR_OK_MIN=5
# FRAICHEUR_ALERTE_MIN=30
# Bandeau affiché en haut de la page (vide : aucun bandeau). Mode producteur synthétique :
DASHBOARD_BANDEAU=Données synthétiques

# Scoreur à modèles CamemBERT (décrit dans le contrat). Tout vide : les règles lexique restent seules.
# Dossier hôte des runs, hors dépôt (ex. $SAE_CORPUS_DIR/modeles) ; monté en lecture seule.
MODELES_DIR=
# Noms de runs sous MODELES_DIR (retenus : stance-20261101-1457, emotion-20261101-1453). Un changement modifie
# la valeur `scoreur` : rupture de série dans croisements_fenetre.
MODELE_STANCE=
MODELE_EMOTION=
# Limite mémoire de chaque worker : JVM + executor + Python avec modèles (budget dans infra/AGENTS.md).
WORKER_MEM_LIMIT=4096m
