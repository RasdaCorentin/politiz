# Copier en .env (non versionné) puis adapter.

# Dossier de l'hôte qui contient bluesky_posts.db (bind mount sur /data).
# Il doit exister et appartenir à COLLECTE_UID:COLLECTE_GID.
COLLECTE_DATA_DIR=/srv/sae-collecte/data

# uid/gid du propriétaire de ce dossier (commande : id -u ; id -g)
COLLECTE_UID=1000
COLLECTE_GID=1000
